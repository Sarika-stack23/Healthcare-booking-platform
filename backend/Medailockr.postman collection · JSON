{
  "info": {
    "name": "MedAILockr Healthcare API",
    "description": "Complete API collection for MedAILockr Healthcare Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "doctorToken", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "patientId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "recordId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  pm.collectionVariables.set('patientId', res.data.user._id);",
                  "  pm.test('Patient registered', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john2@example.com\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"role\": \"patient\",\n  \"phone\": \"+91 9876543210\"\n}"
            }
          }
        },
        {
          "name": "Register Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('doctorToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('doctorId', res.data.user._id);",
                  "  pm.test('Doctor registered', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Dr. Sarah\",\n  \"lastName\": \"Smith\",\n  \"email\": \"sarah2@example.com\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"role\": \"doctor\",\n  \"specialization\": \"Cardiology\",\n  \"consultationFee\": 500,\n  \"qualifications\": [\"MBBS\", \"MD Cardiology\"],\n  \"experienceYears\": 10\n}"
            }
          }
        },
        {
          "name": "Login Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  pm.collectionVariables.set('patientId', res.data.user._id);",
                  "  pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('doctorToken', res.data.accessToken);",
                  "  pm.collectionVariables.set('doctorId', res.data.user._id);",
                  "  pm.test('Doctor login successful', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sarah@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/reset-password/RESET_TOKEN_HERE",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPassword123\",\n  \"confirmPassword\": \"NewPassword123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "👤 Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/profile"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Updated\",\n  \"phone\": \"+91 9876543210\",\n  \"patientProfile\": {\n    \"bloodGroup\": \"O+\",\n    \"allergies\": [\"Penicillin\", \"Pollen\"],\n    \"emergencyContact\": {\n      \"name\": \"Jane Doe\",\n      \"phone\": \"+91 9876543211\",\n      \"relation\": \"Spouse\"\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/doctors?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "specialization", "value": "Cardiology", "disabled": true },
                { "key": "minFee", "value": "100", "disabled": true },
                { "key": "maxFee", "value": "1000", "disabled": true },
                { "key": "search", "value": "Sarah", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Doctor By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/users/doctors/{{doctorId}}"
          }
        }
      ]
    },
    {
      "name": "📅 Doctor Availability",
      "item": [
        {
          "name": "Get Availability",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability"
          }
        },
        {
          "name": "Set Weekly Schedule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability/weekly",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule\": [\n    {\n      \"dayOfWeek\": \"monday\",\n      \"isAvailable\": true,\n      \"slots\": [\n        {\"start\": \"09:00\", \"end\": \"13:00\"},\n        {\"start\": \"14:00\", \"end\": \"17:00\"}\n      ]\n    },\n    {\n      \"dayOfWeek\": \"wednesday\",\n      \"isAvailable\": true,\n      \"slots\": [\n        {\"start\": \"10:00\", \"end\": \"14:00\"}\n      ]\n    },\n    {\n      \"dayOfWeek\": \"friday\",\n      \"isAvailable\": true,\n      \"slots\": [\n        {\"start\": \"09:00\", \"end\": \"13:00\"},\n        {\"start\": \"14:00\", \"end\": \"17:00\"}\n      ]\n    }\n  ],\n  \"slotDurationMinutes\": 30\n}"
            }
          }
        },
        {
          "name": "Set Date Override",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability/overrides",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-03-10\",\n  \"isAvailable\": false,\n  \"slots\": [],\n  \"reason\": \"Doctor on leave\"\n}"
            }
          }
        },
        {
          "name": "Get Available Slots",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/doctors/{{doctorId}}/available-slots?date=2026-03-06",
              "query": [{ "key": "date", "value": "2026-03-06" }]
            }
          }
        },
        {
          "name": "Set Break Times",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability/breaks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"breaks\": [\n    {\n      \"dayOfWeek\": \"friday\",\n      \"start\": \"13:00\",\n      \"end\": \"14:00\",\n      \"isRecurring\": true\n    }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🗓️ Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('appointmentId', res.data.appointment._id);",
                  "  pm.test('Appointment booked', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduledDate\": \"2026-03-13\",\n  \"scheduledTime\": \"09:00\",\n  \"reasonForVisit\": \"Chest pain and shortness of breath\",\n  \"symptoms\": [\"chest pain\", \"shortness of breath\", \"fatigue\"]\n}"
            }
          }
        },
        {
          "name": "Book Same Slot (Conflict Test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"scheduledDate\": \"2026-03-13\",\n  \"scheduledTime\": \"09:00\",\n  \"reasonForVisit\": \"Testing conflict detection\"\n}"
            }
          }
        },
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/appointments?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "scheduled", "disabled": true },
                { "key": "startDate", "value": "2026-03-01", "disabled": true },
                { "key": "endDate", "value": "2026-03-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Appointment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "Reschedule Appointment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/reschedule",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheduledDate\": \"2026-03-13\",\n  \"scheduledTime\": \"10:00\",\n  \"reason\": \"Conflict with work schedule\"\n}"
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Patient unable to attend due to personal emergency\"\n}"
            }
          }
        },
        {
          "name": "Complete Appointment (Doctor)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctorToken}}" }],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/complete"
          }
        }
      ]
    },
    {
      "name": "🗂️ Medical Records",
      "item": [
        {
          "name": "Upload Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) {",
                  "  pm.collectionVariables.set('recordId', res.data.record._id);",
                  "  pm.test('Record uploaded', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/records/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "title", "value": "Blood Test Report", "type": "text" },
                { "key": "description", "value": "CBC and metabolic panel results", "type": "text" },
                { "key": "recordType", "value": "lab_report", "type": "text" },
                { "key": "tags", "value": "blood,cbc,metabolic", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "List Records",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/records?page=1&limit=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "recordType", "value": "lab_report", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Record",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/records/{{recordId}}"
          }
        },
        {
          "name": "Download Record",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/records/{{recordId}}/download"
          }
        },
        {
          "name": "Delete Record",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/records/{{recordId}}"
          }
        }
      ]
    },
    {
      "name": "🏥 Health Checks",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/health"
          }
        },
        {
          "name": "Ready Check",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/ready"
          }
        },
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "url": "http://localhost:5001/api"
          }
        }
      ]
    }
  ]
}